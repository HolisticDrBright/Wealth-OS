# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Supabase project credentials (use the service role key — NOT the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal API auth — same value as Vercel env and GitHub Actions secret
WEALTH_OS_API_KEY=<openssl rand -hex 32>

# Production URL (used by scan service to call the API)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── BROKER CREDENTIALS — add the exchanges you use ───────────────────────────
# Alpaca (US stocks)
# ALPACA_API_KEY=PK...
# ALPACA_SECRET_KEY=...
# ALPACA_BASE_URL=https://paper-api.alpaca.markets   # remove for live

# Coinbase Advanced (crypto spot)
# COINBASE_API_KEY=...
# COINBASE_API_SECRET=...

# Kraken (crypto)
# KRAKEN_API_KEY=...
# KRAKEN_API_SECRET=...

# OANDA (forex)
# OANDA_API_KEY=...
# OANDA_ACCOUNT_ID=...

# TastyFX / Tastytrade (options)
# TASTYTRADE_USERNAME=...
# TASTYTRADE_PASSWORD=...

# ─── OPTIONAL — data enrichment ───────────────────────────────────────────────
# Unusual Whales (options flow)
# UNUSUAL_WHALES_API_KEY=...

# Quiver Quant (congressional / insider data)
# QUIVER_QUANT_API_KEY=...

# Nansen (on-chain analytics)
# NANSEN_API_KEY=...

# MiroFish AI confluence (required for MF-tier strategies)
# MIROFISH_API_KEY=...

# CoinStats (crypto portfolio)
# COINSTATS_API_KEY=...

# ─── RUNTIME (defaults are fine for most deployments) ─────────────────────────
# NODE_ENV=production
# PORT=3001
