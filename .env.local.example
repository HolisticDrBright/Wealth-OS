# Wealth OS — local environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Polymarket Intelligence Sidecar ────────────────────────────────────────
# Base URL for Meta_Poly_tarder sidecar service.
# If unset or unreachable, /polymarket shows setup guide instead of crashing.
META_POLY_URL=http://localhost:8000
# Expose the same URL to the browser for WebSocket connections.
NEXT_PUBLIC_META_POLY_URL=http://localhost:8000

# ── Obsidian Vault (GitHub-backed) ─────────────────────────────────────────
VAULT_GITHUB_TOKEN=github_pat_...
VAULT_OWNER=HolisticDrBright
VAULT_REPO=wealth-os-vault
VAULT_BRANCH=main

# ── Crypto MCP Integrations ────────────────────────────────────────────────
# CryptoPanic — narrative heat scoring for the narrative_rotation strategy.
# Free tier available at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# ── Plaid (read-only account linking — docs/plaid-setup.md) ────────────────
# Start in sandbox (free, fake banks). Switch PLAID_ENV to production only
# after Plaid approves production access.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# 32 random bytes, base64 — encrypts stored access tokens. Generate with:
#   openssl rand -base64 32
# Keep it secret and never change it casually: changing it orphans existing links.
PLAID_TOKEN_KEY=
