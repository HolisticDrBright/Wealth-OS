{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[claude-hook] Bash tool invoked — context-mode active'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run*)",
      "Bash(npx tsx*)",
      "Bash(npx vitest*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(docker compose*)"
    ]
  },
  "env": {
    "CONTEXT_MODE_ENABLED": "true"
  }
}
